      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "./filesystem": {
        "types": "./dist/filesystem.d.ts",
        "import": "./dist/filesystem.js"
      },
      "./r2-workers": {
        "types": "./dist/r2-workers.d.ts",
        "import": "./dist/r2-workers.js"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const directory of ['dist', 'coverage']) rmSync(directory, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint --strict && attw --pack --profile esm-only",
    "lint": "oxlint --deny-warnings src test *.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-presigned-post": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-deno": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "redis": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-presigned-post": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@effect/platform-browser": "^4.1.0",
    "@effect/platform-bun": "^4.1.0",
    "@effect/platform-deno": "^4.1.0",
    "@effect/platform-node": "^4.1.0",
    "effect": "^4.1.0"
  },
