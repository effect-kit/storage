  "bugs": {
    "url": "https://github.com/effect-kit/storage/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Effect Kit Contributors",
    "url": "https://github.com/effect-kit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-kit/storage.git",
    "directory": "packages/storage"
  },
  "files": [
