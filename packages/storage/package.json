    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "workspace-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./s3": {
      "workspace-source": "./src/s3.ts",
      "types": "./dist/s3.d.ts",
      "default": "./dist/s3.js"
    },
    "./s3/signing": {
      "workspace-source": "./src/s3/signing.ts",
      "types": "./dist/s3/signing.d.ts",
      "default": "./dist/s3/signing.js"
    },
    "./s3/post": {
      "workspace-source": "./src/s3/post.ts",
      "types": "./dist/s3/post.d.ts",
      "default": "./dist/s3/post.js"
    },
    "./transfers": {
      "workspace-source": "./src/transfers.ts",
      "types": "./dist/transfers.d.ts",
      "default": "./dist/transfers.js"
    },
    "./sessions": {
      "workspace-source": "./src/sessions.ts",
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    },
    "./node": {
      "workspace-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./bun": {
      "workspace-source": "./src/bun.ts",
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./deno": {
      "workspace-source": "./src/deno.ts",
      "types": "./dist/deno.d.ts",
      "default": "./dist/deno.js"
    },
    "./browser": {
      "workspace-source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./filesystem": {
      "workspace-source": "./src/filesystem.ts",
      "types": "./dist/filesystem.d.ts",
      "default": "./dist/filesystem.js"
    },
    "./r2-workers": {
      "workspace-source": "./src/r2-workers.ts",
      "types": "./dist/r2-workers.d.ts",
      "default": "./dist/r2-workers.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      },
      "./s3": {
        "types": "./dist/s3.d.ts",
        "import": "./dist/s3.js"
      },
      "./s3/signing": {
        "types": "./dist/s3/signing.d.ts",
        "import": "./dist/s3/signing.js"
      },
      "./s3/post": {
        "types": "./dist/s3/post.d.ts",
        "import": "./dist/s3/post.js"
      },
      "./transfers": {
        "types": "./dist/transfers.d.ts",
        "import": "./dist/transfers.js"
      },
      "./sessions": {
        "types": "./dist/sessions.d.ts",
        "import": "./dist/sessions.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
