{
  "name": "effect-kit-storage-workspace",
  "private": true,
  "description": "Effect Kit Storage workspace.",
  "homepage": "https://github.com/effect-kit/storage#readme",
  "bugs": {
    "url": "https://github.com/effect-kit/storage/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Effect Kit Contributors",
    "url": "https://github.com/effect-kit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effect-kit/storage.git"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck typecheck:test",
    "test": "pnpm test:tooling && turbo run test",
    "test:watch": "turbo run test:watch",
    "check": "pnpm format:check && pnpm catalog:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ci:check": "pnpm check",
    "check:package": "turbo run check:package",
    "test:artifacts": "pnpm build && pnpm check:package && node scripts/artifacts/check.ts",
    "test:extended": "pnpm test:artifacts",
    "verify": "pnpm check && pnpm test:extended",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts && pnpm format",
    "release:prepare": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "release:pack": "changeset pack --out-dir .artifacts/release",
    "release:check": "echo \"Not implemented: verify the supplied release archives\"",
    "release:smoke": "echo \"Not implemented: verify the published release\"",
    "prepare": "lefthook install",
    "test:tooling": "node --test scripts/catalog/catalog.test.ts scripts/artifacts/archive-policy.test.ts",
    "catalog:check": "node scripts/catalog/check.ts",
    "test:s3:local": "pnpm build && node scripts/s3/local.ts",
    "test:s3:aws": "pnpm --filter @effect-kit/storage exec vitest run --config vitest.s3.config.ts",
    "test:runtimes": "pnpm build && node scripts/runtime/check.ts",
    "test:filesystem": "pnpm build && node scripts/filesystem/check.ts",
    "test:r2:workers": "pnpm build && node scripts/r2-workers/check.ts",
    "test:native:local": "pnpm build && node scripts/native/check.ts",
    "test:native:hosted": "pnpm --filter @effect-kit/storage exec vitest run --config vitest.native-hosted.config.ts"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "miniflare": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.22.0",
    "pnpm": ">=12.14.0 <13"
  },
  "packageManager": "pnpm@12.14.0"
}
