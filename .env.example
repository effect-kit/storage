# Hosted provider tests only. Copy to .env.providers.local; keep that file private.
# pnpm providers:prepare --credentials-file .env.providers.local --provider s3
# pnpm test:providers --credentials-file .env.providers.local --provider s3
# CI uses --env; ordinary tests never load dotenv files.
# Multiple selections: --provider s3,gcs; all requires every provider to be configured.
# Set an existing isolated bucket/container. Tests write only generated keys under PREFIX.
# Portable suite uses three 32 KiB objects plus streamed input; never creates buckets or changes policy.
# Cleanup failure/unknown writes fail the run; native history/admin/retention are separate qualification lanes.
# Optional --suite signing also requires native signing authority and performs a signed GET.
STORAGE_TEST_PROVIDERS=

# AWS S3: static test credentials, no implicit profile discovery.
STORAGE_TEST_S3_CONFIG='{"bucket":"","region":""}'
STORAGE_TEST_S3_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_S3_ACCESS_KEY_ID=
STORAGE_TEST_S3_SECRET_ACCESS_KEY=
STORAGE_TEST_S3_SESSION_TOKEN=

# Cloudflare R2 through S3; native Worker binding has a separate section below.
STORAGE_TEST_R2_CONFIG='{"bucket":"","accountId":""}'
STORAGE_TEST_R2_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_R2_ACCESS_KEY_ID=
STORAGE_TEST_R2_SECRET_ACCESS_KEY=

# Local MinIO permits HTTP only on localhost/127.0.0.1/[::1]; remote endpoints require HTTPS.
STORAGE_TEST_MINIO_CONFIG='{"bucket":"","region":"","endpoint":"","edition":"community","serverVersion":"","versioning":false}'
STORAGE_TEST_MINIO_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_MINIO_ACCESS_KEY_ID=
STORAGE_TEST_MINIO_SECRET_ACCESS_KEY=

STORAGE_TEST_TIGRIS_CONFIG='{"bucket":"","placement":"multi-region"}'
STORAGE_TEST_TIGRIS_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_TIGRIS_ACCESS_KEY_ID=
STORAGE_TEST_TIGRIS_SECRET_ACCESS_KEY=

STORAGE_TEST_SPACES_CONFIG='{"bucket":"","region":"","tier":"standard"}'
STORAGE_TEST_SPACES_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_SPACES_ACCESS_KEY_ID=
STORAGE_TEST_SPACES_SECRET_ACCESS_KEY=

STORAGE_TEST_B2_CONFIG='{"bucket":"","region":""}'
STORAGE_TEST_B2_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_B2_ACCESS_KEY_ID=
STORAGE_TEST_B2_SECRET_ACCESS_KEY=

STORAGE_TEST_WASABI_CONFIG='{"bucket":"","region":""}'
STORAGE_TEST_WASABI_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_WASABI_ACCESS_KEY_ID=
STORAGE_TEST_WASABI_SECRET_ACCESS_KEY=

STORAGE_TEST_SCALEWAY_CONFIG='{"bucket":"","region":""}'
STORAGE_TEST_SCALEWAY_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_SCALEWAY_ACCESS_KEY_ID=
STORAGE_TEST_SCALEWAY_SECRET_ACCESS_KEY=

STORAGE_TEST_HETZNER_CONFIG='{"bucket":"","region":"","versioning":false}'
STORAGE_TEST_HETZNER_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_HETZNER_ACCESS_KEY_ID=
STORAGE_TEST_HETZNER_SECRET_ACCESS_KEY=

# Google service-account JSON. Use a single-quoted dotenv value; JSON keeps literal \n escapes.
STORAGE_TEST_GCS_CONFIG='{"bucket":"","projectId":""}'
STORAGE_TEST_GCS_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_GCS_CREDENTIALS_JSON=

STORAGE_TEST_AZURE_CONFIG='{"containerUrl":"https://ACCOUNT.blob.core.windows.net/CONTAINER"}'
STORAGE_TEST_AZURE_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_AZURE_ACCOUNT_NAME=
STORAGE_TEST_AZURE_ACCOUNT_KEY=

# user token must have access to PREFIX under your existing RLS policy; service is explicitly privileged.
STORAGE_TEST_SUPABASE_CONFIG='{"url":"https://PROJECT.supabase.co","bucket":"","storeId":"supabase-test"}'
STORAGE_TEST_SUPABASE_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_SUPABASE_AUTH_MODE=user
STORAGE_TEST_SUPABASE_TOKEN=
# Optional project publishable/anon API key when required by the project gateway.
STORAGE_TEST_SUPABASE_API_KEY=

STORAGE_TEST_VERCEL_CONFIG='{"storeId":"","access":"private"}'
STORAGE_TEST_VERCEL_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_VERCEL_TOKEN=

# Native R2 requires the test-only Worker bundle served from a dedicated owned deployment.
# pnpm providers:worker builds .artifacts/providers/worker.js; it does not deploy.
# Binding BUCKET -> existing bucket; secret STORAGE_TEST_TOKEN; variable STORAGE_TEST_PREFIX -> PREFIX below.
# Configure that deployment separately, then provide its HTTPS URL and matching secret here.
STORAGE_TEST_R2_WORKERS_CONFIG='{"url":"https://WORKER.SUBDOMAIN.workers.dev"}'
STORAGE_TEST_R2_WORKERS_PREFIX=effect-storage-acceptance/storage-sdk/
STORAGE_TEST_R2_WORKERS_TOKEN=
